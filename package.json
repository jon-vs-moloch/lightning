{
  "name": "lightning",
  "version": "0.0.0",
  "description": "A branch-and-checkpoint runtime sketch for LLM agents: context as a checkpoint you continue from, not a transcript you replay.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/jon-vs-moloch/lightning.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "demo": "npm run build && node dist/examples/in-memory-demo.js",
    "demo:ui": "npm run build && node dist/examples/inspector-demo.js",
    "demo:kv": "npm run build && node dist/examples/kv-cache-demo.js",
    "serve": "npm run build && node dist/server.js",
    "test": "npm run build && node --test dist/tests/*.js"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "typescript": "^5.8.3"
  }
}
